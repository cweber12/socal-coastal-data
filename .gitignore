__pycache__/
.env
*.pyc

# web frontend
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
.vercel

# Design-flow screenshot evidence. Regenerate with the Playwright capture
# described in .design/ui-polish/TASKS.md; 7.6 MB of @2x PNGs does not belong
# in a repo whose whole argument is that it carries no weight it does not need.
.design/*/screenshots/

# Claude Code: settings.json is the shared project allowlist and is tracked.
# settings.local.json is per-machine by convention and must not be.
.claude/settings.local.json

# Calibration raw pulls. Roughly a third of the iNaturalist corpus is All Rights
# Reserved or No Derivatives, so the joined rows cannot be redistributed. What IS
# committed is the counts, the queries and the content hash -- everything needed
# to check a number without republishing the records behind it.
calibration/cache/

# The offline run's report. Regenerated on every `npm run calibrate` and on every
# CI run, and it is not the deliverable -- calibration/out/report.md, written by
# the live run against the whole corpus, is.
calibration/out/report.fixtures.md
