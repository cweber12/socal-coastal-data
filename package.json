{
  "name": "socal-coastal-data-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web frontend for the San Diego corridor tide window grid. Shares shared/spots.json with verify_coastal_apis.py.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-spots-types.mjs",
    "gen:types:check": "node scripts/gen-spots-types.mjs --check"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
